---
title: Waypoints
layout: default
galleries:
  - title: "Travel"
    url: "/photography/travel/"
    thumb: "https://your-bucket.backblazeb2.com/covers/travel.jpg"
  - title: "Portraits"
    url: "/photography/portraits/"
    thumb: "https://your-bucket.backblazeb2.com/covers/portraits.jpg"
  - title: "Street"
    url: "/photography/street/"
    thumb: "https://your-bucket.backblazeb2.com/covers/street.jpg"
  - title: "Landscape"
    url: "/photography/landscape/"
    thumb: "https://your-bucket.backblazeb2.com/covers/landscape.jpg"
  - title: "Still Life"
    url: "/photography/still-life/"
    thumb: "https://your-bucket.backblazeb2.com/covers/still-life.jpg"
  - title: "Fine Art"
    url: "/photography/fine-art/"
    thumb: "https://your-bucket.backblazeb2.com/covers/fine-art.jpg"
---

<%# Gallery grid — edge to edge %>
<section style="margin:2px;">
  <div class="gallery-grid">
    <% resource.data.galleries.each do |gallery| %>
      <a href="<%= gallery['url'] %>" class="gallery-item">
        <img src="<%= gallery['thumb'] %>" alt="<%= gallery['title'] %>" loading="lazy" />
        <div class="gallery-overlay">
          <span class="gallery-overlay-title"><%= gallery['title'] %></span>
          <span class="gold-rule" style="margin-top:12px;"></span>
          <span class="gallery-overlay-sub">View Gallery</span>
        </div>
      </a>
    <% end %>
  </div>
</section>

<%# Journal %>
<section class="mx-auto max-w-3xl px-8" style="margin-top:96px;margin-bottom:96px;">

  <div class="section-label" style="padding-bottom:24px;border-bottom:1px solid #1a1a1a;margin-bottom:48px;">
    Latest from the Journal
  </div>

  <% posts = site.collections.posts.resources.sort_by(&:date).reverse.first(3) %>
  <% if posts.any? %>
    <div>
      <% posts.each do |post| %>
        <div style="padding:32px 0;border-bottom:1px solid #141414;">
          <div class="journal-meta" style="margin-bottom:10px;">
            <time datetime="<%= post.date.xmlschema %>"><%= post.date.strftime("%B %-d, %Y") %></time>
            <% if post.data.location %>&nbsp;&nbsp;·&nbsp;&nbsp;<%= post.data.location %><% end %>
          </div>
          <a href="<%= post.relative_url %>" class="journal-post-title" style="display:block;margin-bottom:12px;">
            <%= post.data.title %>
          </a>
          <% if post.data.excerpt %>
            <p style="font-size:14px;line-height:1.8;color:#5a5650;font-weight:300;"><%= post.data.excerpt %></p>
          <% end %>
        </div>
      <% end %>
    </div>
    <div style="margin-top:48px;">
      <a href="/journal/" class="accent-link">All posts &rarr;</a>
    </div>
  <% else %>
    <p style="color:#3a3830;font-size:14px;">No posts yet — check back soon.</p>
  <% end %>
</section>
