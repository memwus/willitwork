---
title: Waypoints
layout: default
galleries:
  - title: "Travel"
    url: "/photography/travel/"
    thumb: "https://your-bucket.backblazeb2.com/covers/travel.jpg"
  - title: "Portraits"
    url: "/photography/portraits/"
    thumb: "https://your-bucket.backblazeb2.com/covers/portraits.jpg"
  - title: "Street"
    url: "/photography/street/"
    thumb: "https://your-bucket.backblazeb2.com/covers/street.jpg"
  - title: "Landscape"
    url: "/photography/landscape/"
    thumb: "https://your-bucket.backblazeb2.com/covers/landscape.jpg"
  - title: "Still Life"
    url: "/photography/still-life/"
    thumb: "https://your-bucket.backblazeb2.com/covers/still-life.jpg"
  - title: "Fine Art"
    url: "/photography/fine-art/"
    thumb: "https://your-bucket.backblazeb2.com/covers/fine-art.jpg"
---

<%# Gallery grid %>
<section class="mb-16">
  <div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
    <% resource.data.galleries.each do |gallery| %>
      <a href="<%= gallery['url'] %>" class="group relative overflow-hidden block bg-waypoints-surface" style="aspect-ratio: 4/3;">
        <img
          src="<%= gallery['thumb'] %>"
          alt="<%= gallery['title'] %>"
          loading="lazy"
          class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
        />
        <div class="absolute inset-0 bg-black/0 group-hover:bg-black/50 transition-colors duration-300 flex items-center justify-center">
          <span class="text-white font-serif text-xl opacity-0 group-hover:opacity-100 transition-opacity duration-300 tracking-wide">
            <%= gallery['title'] %>
          </span>
        </div>
      </a>
    <% end %>
  </div>
</section>

<%# Journal %>
<section>
  <h2 class="text-xs uppercase tracking-widest text-waypoints-muted mb-6">Latest from the Journal</h2>
  <% posts = site.collections.posts.resources.sort_by(&:date).reverse.first(3) %>
  <% if posts.any? %>
    <div class="space-y-6">
      <% posts.each do |post| %>
        <div class="border-b border-waypoints-border pb-6">
          <h3 class="font-serif text-xl mb-1">
            <a href="<%= post.relative_url %>" class="text-waypoints-text hover:text-waypoints-accent"><%= post.data.title %></a>
          </h3>
          <p class="text-sm text-waypoints-muted">
            <time datetime="<%= post.date.xmlschema %>"><%= post.date.strftime("%B %-d, %Y") %></time>
            <% if post.data.location %>&nbsp;·&nbsp; <%= post.data.location %><% end %>
          </p>
          <% if post.data.excerpt %>
            <p class="text-waypoints-muted text-sm mt-2 leading-relaxed"><%= post.data.excerpt %></p>
          <% end %>
        </div>
      <% end %>
    </div>
    <a href="/journal/" class="inline-block mt-6 text-sm text-waypoints-accent hover:underline">All posts &rarr;</a>
  <% else %>
    <p class="text-waypoints-muted">No posts yet — check back soon.</p>
  <% end %>
</section>
