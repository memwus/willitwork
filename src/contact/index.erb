---
title: Contact
layout: default
permalink: /contact/
---
<section class="mx-auto max-w-lg">
  <h1 class="font-serif text-3xl sm:text-4xl mb-4">Contact</h1>
  <p class="text-waypoints-muted mb-10">Send a message — I'll reply when I have signal.</p>
  <form name="contact" method="POST" data-netlify="true" action="/contact/thanks/" class="space-y-6">
    <input type="hidden" name="form-name" value="contact" />
    <div>
      <label for="name" class="block text-sm text-waypoints-muted mb-2">Name</label>
      <input type="text" id="name" name="name" required class="w-full bg-waypoints-surface border border-waypoints-border rounded px-4 py-3 text-waypoints-text focus:outline-none focus:border-waypoints-accent transition-colors" placeholder="Your name" />
    </div>
    <div>
      <label for="email" class="block text-sm text-waypoints-muted mb-2">Email</label>
      <input type="email" id="email" name="email" required class="w-full bg-waypoints-surface border border-waypoints-border rounded px-4 py-3 text-waypoints-text focus:outline-none focus:border-waypoints-accent transition-colors" placeholder="you@example.com" />
    </div>
    <div>
      <label for="message" class="block text-sm text-waypoints-muted mb-2">Message</label>
      <textarea id="message" name="message" required rows="5" class="w-full bg-waypoints-surface border border-waypoints-border rounded px-4 py-3 text-waypoints-text focus:outline-none focus:border-waypoints-accent transition-colors resize-none" placeholder="..."></textarea>
    </div>
    <button type="submit" class="w-full bg-waypoints-accent text-waypoints-bg font-medium rounded px-6 py-3 hover:opacity-90 transition-opacity">Send message</button>
  </form>
</section>
