---
title: Journal
layout: default
permalink: /journal/
---
<section class="mx-auto max-w-3xl px-8" style="padding-top:72px;padding-bottom:96px;">

  <div style="margin-bottom:64px;">
    <h1 class="page-heading">Journal</h1>
    <span class="gold-rule" style="margin-top:16px;"></span>
  </div>

  <% posts = site.collections.posts.resources.sort_by(&:date).reverse %>
  <% if posts.any? %>
    <div>
      <% posts.each do |post| %>
        <div style="padding:36px 0;border-bottom:1px solid #141414;">
          <div class="journal-meta" style="margin-bottom:10px;">
            <time datetime="<%= post.date.xmlschema %>"><%= post.date.strftime("%B %-d, %Y") %></time>
            <% if post.data.location %>&nbsp;&nbsp;·&nbsp;&nbsp;<%= post.data.location %><% end %>
          </div>
          <a href="<%= post.relative_url %>" class="journal-post-title" style="display:block;margin-bottom:12px;">
            <%= post.data.title %>
          </a>
          <% if post.data.excerpt %>
            <p style="font-size:14px;line-height:1.8;color:#5a5650;font-weight:300;"><%= post.data.excerpt %></p>
          <% end %>
        </div>
      <% end %>
    </div>
  <% else %>
    <p style="color:#3a3830;font-size:14px;">No posts yet — check back soon.</p>
  <% end %>
</section>
