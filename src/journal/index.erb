---
title: Journal
layout: default
permalink: /journal/
---
<section class="mx-auto max-w-2xl">
  <h1 class="font-serif text-3xl sm:text-4xl mb-10">Journal</h1>
  <% posts = site.collections.posts.resources.sort_by(&:date).reverse %>
  <% if posts.any? %>
    <ul class="space-y-8">
      <% posts.each do |post| %>
        <li class="border-b border-waypoints-border pb-8">
          <h2 class="font-serif text-xl mb-1">
            <a href="<%= post.relative_url %>" class="text-waypoints-text hover:text-waypoints-accent"><%= post.data.title %></a>
          </h2>
          <p class="text-sm text-waypoints-muted mb-3">
            <time datetime="<%= post.date.xmlschema %>"><%= post.date.strftime("%B %-d, %Y") %></time>
            <% if post.data.location %>&nbsp;·&nbsp; <%= post.data.location %><% end %>
          </p>
          <% if post.data.excerpt %>
            <p class="text-waypoints-muted text-sm leading-relaxed"><%= post.data.excerpt %></p>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="text-waypoints-muted">No posts yet — check back soon.</p>
  <% end %>
</section>
