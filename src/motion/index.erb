---
title: Motion
layout: default
permalink: /motion/
videos:
  - src: "https://your-bucket.backblazeb2.com/motion/clip-001.mp4"
    thumb: "https://your-bucket.backblazeb2.com/motion/thumbs/clip-001.jpg"
    caption: ""
---
<section>
  <h1 class="font-serif text-3xl sm:text-4xl mb-10">Motion</h1>
  <% videos = resource.data.videos %>
  <% if videos && videos.any? %>
    <div class="gallery-grid">
      <% videos.each do |item| %>
        <div class="gallery-item rounded" data-lightbox data-src="<%= item['src'] %>" data-type="video" data-caption="<%= item['caption'] %>">
          <% if item['thumb'] %>
            <img src="<%= item['thumb'] %>" alt="<%= item['caption'] %>" loading="lazy" />
          <% else %>
            <video src="<%= item['src'] %>" muted loop playsinline class="w-full h-full object-cover"></video>
          <% end %>
          <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
            <div class="w-12 h-12 rounded-full bg-black/50 flex items-center justify-center">
              <svg class="w-5 h-5 text-white ml-1" fill="currentColor" viewBox="0 0 20 20"><path d="M6.3 2.84A1.5 1.5 0 004 4.11v11.78a1.5 1.5 0 002.3 1.27l9.34-5.89a1.5 1.5 0 000-2.54L6.3 2.84z"/></svg>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="text-waypoints-muted">No videos yet.</p>
  <% end %>
</section>
